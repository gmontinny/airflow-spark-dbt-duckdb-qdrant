    TRY_CAST(ingested_at AS TIMESTAMP)                      AS ingested_at
FROM "lakehouse"."bronze"."documentos_raw"
WHERE content IS NOT NULL
  AND TRIM(content) != ''
  AND content_length > 50
    );
    
  
